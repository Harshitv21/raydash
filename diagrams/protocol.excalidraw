      "isDeleted": false,
      "boundElements": null,
      "updated": 1791056679446,
      "link": null,
      "locked": false,
      "text": "This protocol diagram will focus mainly on our\nbinary safe byte framing or simply binary safe protocol.\nIt was originally redesigned from now scrapped line based\nreading protocol which had far too many flaws to be\ncontinued longterm.\nIn this example we will show the difference and why our\ncurrent approach is far superior than the previous one.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This protocol diagram will focus mainly on our\nbinary safe byte framing or simply binary safe protocol.\nIt was originally redesigned from now scrapped line based\nreading protocol which had far too many flaws to be\ncontinued longterm.\nIn this example we will show the difference and why our\ncurrent approach is far superior than the previous one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
