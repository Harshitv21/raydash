    {
      "id": "h6SUvd_Dlv7F4V2MYfgxs",
      "type": "text",
      "x": 1735.2496858773088,
      "y": 630.9622463062063,
      "width": 369.1078875951523,
      "height": 141.5621480791625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2v",
      "roundness": null,
      "seed": 1955993837,
      "version": 1228,
      "versionNonce": 981050403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791057815367,
      "link": null,
      "locked": false,
      "text": "For a data exactly like this our binary safe\nprotocol shines. No matter how many carriage\nreturns or newline or any character virtually\npossible that is valid, it will do the same 2\noperations, take the length make a payload of\nexact same size and then iterate over it byte\nby byte never a byte less never a byte more!",
      "fontSize": 16.178531209047154,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For a data exactly like this our binary safe\nprotocol shines. No matter how many carriage\nreturns or newline or any character virtually\npossible that is valid, it will do the same 2\noperations, take the length make a payload of\nexact same size and then iterate over it byte\nby byte never a byte less never a byte more!",
      "autoResize": false,
      "lineHeight": 1.25
    },
